rules_version = '2';

// ===============================================================
// Modelo de datos asumido
// ===============================================================
//
// Colección: progress
// Id del documento: uid de Firebase Authentication
// Campos (todos obligatorios, no se permite ningún otro):
//   - userId: string. Igual al uid autenticado y al id del documento.
//   - authProvider: string. 'anonymous', 'password' o 'google.com'.
//   - house: string o null. Una de las 4 casas.
//   - wand: string o null. Una de las 4 varitas.
//   - spells: lista de strings. Hasta 3 hechizos válidos, sin repetir.
//   - items: lista de strings. Hasta 7 ítems válidos, sin repetir.
//   - currentPlace: string o null. Uno de los 7 lugares.
//   - ending: string o null. Igual a house, y solo si items incluye
//     'camara-abierta'.
//   - updatedAt: timestamp. Lo pone el servidor (serverTimestamp()).
//
// El cliente escribe siempre el documento completo (setDoc sin merge).
// Un documento de la Fase 1 con el campo clues se puede leer, y la
// primera escritura lo reemplaza por uno válido.
//
// Colección: users
// Id del documento: uid de Firebase Authentication
// Campos: userId, email, displayName, photoURL, isAnonymous,
//   authProvider, createdAt, lastLoginAt. Contiene datos personales:
//   solo lo lee su dueño. El cliente escribe con setDoc y merge: true.
//   - email: el del token de Auth, o null en las cuentas anónimas.
//   - displayName (hasta 120) y photoURL (hasta 2048): string o null.
//   - createdAt: solo al crear, con serverTimestamp(). Después no cambia.
//   - lastLoginAt: serverTimestamp() en cada escritura.
//   Los perfiles anteriores con otros campos se pueden seguir actualizando:
//   en update solo se limita qué campos cambian.
//
// Las listas de ids están copiadas de data/houses.js, data/wands.js,
// data/spells.js y data/places.js. Si cambian allá, cambian acá.
//
// Todo lo que no coincide con un match queda denegado.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Funciones auxiliares
    // -------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // null o uno de los valores permitidos.
    function isNullOr(value, allowed) {
      return value == null || (value is string && value in allowed);
    }

    // Lista acotada, con valores permitidos y sin repetidos.
    function isIdList(value, allowed, maxSize) {
      return value is list
        && value.size() <= maxSize
        && value.hasOnly(allowed)
        && value.toSet().size() == value.size();
    }

    // -------------------------------------------------------------
    // Valores válidos del juego
    // -------------------------------------------------------------

    function validHouses() {
      return ['gryffindor', 'hufflepuff', 'ravenclaw', 'slytherin'];
    }

    function validWands() {
      return ['sauce-unicornio', 'cerezo-dragon', 'nogal-fenix', 'abedul-unicornio'];
    }

    function validSpells() {
      return ['lumos', 'alohomora', 'accio'];
    }

    function validItems() {
      return ['sombrero', 'varita', 'pagina-1', 'pagina-2', 'pagina-3', 'capa',
              'camara-abierta'];
    }

    function validPlaces() {
      return ['gran-comedor', 'ollivanders', 'escaleras', 'pasillo', 'quidditch',
              'trofeos', 'camara'];
    }

    function validProviders() {
      return ['anonymous', 'password', 'google.com'];
    }

    function progressFields() {
      return ['userId', 'authProvider', 'house', 'wand', 'spells', 'items',
              'currentPlace', 'ending', 'updatedAt'];
    }

    // -------------------------------------------------------------
    // Validador de progress (se usa en create y en update)
    // -------------------------------------------------------------

    function isValidProgress(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(progressFields())
        && data.keys().hasAll(progressFields())
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.authProvider is string
        && data.authProvider in validProviders()
        && isNullOr(data.house, validHouses())
        && isNullOr(data.wand, validWands())
        && isNullOr(data.currentPlace, validPlaces())
        && isIdList(data.spells, validSpells(), 3)
        && isIdList(data.items, validItems(), 7)
        && (data.ending == null
            || (data.ending == data.house && 'camara-abierta' in data.items))
        && data.updatedAt == request.time;
    }

    // -------------------------------------------------------------
    // Validador de users (perfil que se escribe en cada login)
    // -------------------------------------------------------------

    function userFields() {
      return ['userId', 'email', 'displayName', 'photoURL', 'isAnonymous',
              'authProvider', 'createdAt', 'lastLoginAt'];
    }

    // null o un string de hasta maxSize caracteres.
    function isNullOrShortString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    // El email tiene que ser el de la cuenta (o null en las anónimas): no se
    // puede escribir uno ajeno.
    function isValidUser(userId) {
      let data = request.resource.data;
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.email == request.auth.token.get('email', null)
        && isNullOrShortString(data.displayName, 120)
        && isNullOrShortString(data.photoURL, 2048)
        && data.isAnonymous is bool
        && data.authProvider is string
        && data.authProvider in validProviders()
        && data.lastLoginAt == request.time;
    }

    // -------------------------------------------------------------
    // Colecciones
    // -------------------------------------------------------------

    match /progress/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProgress(userId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Alta: solo los campos del perfil, con tipos y largos acotados.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && request.resource.data.keys().hasAll(userFields())
        && isValidUser(userId)
        && request.resource.data.createdAt == request.time;

      // Cada login: se pueden tocar solo los campos que escribe la app.
      // Se compara contra lo que cambia (y no contra todas las claves) para
      // que los perfiles anteriores con otros campos sigan pudiendo entrar.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userId', 'email', 'displayName', 'photoURL',
                       'isAnonymous', 'authProvider', 'lastLoginAt'])
        && isValidUser(userId);
    }
  }
}
